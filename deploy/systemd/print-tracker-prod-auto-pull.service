[Unit]
Description=Update and rebuild Print Tracker PROD from GitHub
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/print-tracker-prod
Environment=APP_DIR=/opt/print-tracker-prod
Environment=BRANCH=master
Environment=SERVICE_NAME=print-tracker-prod.service
ExecStart=/opt/print-tracker-prod/deploy/scripts/auto-pull.sh
